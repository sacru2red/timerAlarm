{
  "name": "timer-alarm",
  "version": "0.1.0",
  "description": "Discord voice bot that counts down alarms on voice command",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --env-file=.env --watch src/index.ts",
    "test": "node --test",
    "typecheck": "tsc",
    "lint": "eslint .",
    "deploy-commands": "node --env-file-if-exists=.env scripts/deploy-commands.ts",
    "fetch-model": "node --env-file-if-exists=.env scripts/fetch-model.ts",
    "encode-clips": "node scripts/encode-clips.ts",
    "stt-bench": "node --env-file-if-exists=.env scripts/stt-bench.ts",
    "load-test": "node --env-file-if-exists=.env scripts/load-test.ts"
  },
  "dependencies": {
    "@discordjs/opus": "^0.11.0",
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.28.1",
    "sherpa-onnx-node": "2.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "eslint": "^10.15.0",
    "neostandard": "^0.14.1",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "@discordjs/opus@0.11.0": true
  },
  "overrides": {
    "tar": "^7.5.24"
  }
}
